# Local environment. Copy to .env next to docker-compose.yaml; .env is ignored by Git.
# Placeholders only: never commit real values. Variables are grouped by the container that receives them.

# --- PostgreSQL ------------------------------------------------------------------------------------------
POSTGRES_USER="wrench"
POSTGRES_PASSWORD="REPLACE_WITH_RANDOM_PASSWORD"
POSTGRES_DB="wrench"

# --- Wrench --------------------------------------------------------------------------------------------------
WRENCH_PUBLIC_URL="http://127.0.0.1:8080"
WRENCH_WEB_SESSION_TTL="12h"
WRENCH_CLIENT_KEYS_TTL="168h"

# Owner connection; the password must match POSTGRES_PASSWORD.
WRENCH_POSTGRES_DSN="postgres://wrench:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/wrench?sslmode=disable"

WRENCH_GITLAB_URL="https://gitlab.example.com"
WRENCH_GITLAB_CLIENT_ID="REPLACE_WITH_OIDC_APPLICATION_ID"
WRENCH_GITLAB_CLIENT_SECRET="REPLACE_WITH_OIDC_APPLICATION_SECRET"

# read_api token for account-state checks.
WRENCH_GITLAB_SYNC_TOKEN="REPLACE_WITH_READ_API_TOKEN"
WRENCH_GITLAB_SYNC_INTERVAL="5m"

# OpenRouter API base (optional) and key. Only Wrench holds the key; set a credit limit on it in OpenRouter.
WRENCH_OPENROUTER_URL="https://openrouter.ai/api/v1"
WRENCH_OPENROUTER_KEY="REPLACE_WITH_OPENROUTER_API_KEY"

WRENCH_UPSTREAM_TIMEOUT_CONNECT="10s"
WRENCH_UPSTREAM_TIMEOUT_FIRST_TOKEN="90s"
WRENCH_UPSTREAM_TIMEOUT_STREAM_IDLE="90s"
WRENCH_UPSTREAM_TIMEOUT_TOTAL="10m"
WRENCH_UPSTREAM_CONCURRENCY_PER_USER="3"
WRENCH_UPSTREAM_CONCURRENCY_GLOBAL="60"
WRENCH_SESSION_OFFLINE_AFTER="60s"

# Slack/Mattermost-compatible incoming webhook; empty only logs and shows alerts.
WRENCH_ALERT_WEBHOOK_URL=""
WRENCH_LOG_LEVEL="info"

# Organization name opencode shows for this server (optional; default Wrench).
WRENCH_ORG_NAME=""
